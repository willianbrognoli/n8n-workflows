    {
      "parameters": {
        "jsCode": "// Converte o XML dos feeds em itens (title, link, isoDate, contentSnippet, categories, source)\nconst decode = (s) => String(s || '')\n  .replace(/<!\\[CDATA\\[([\\s\\S]*?)\\]\\]>/g, '$1')\n  .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"').replace(/&#0?39;/g, \"'\").replace(/&nbsp;/g, ' ');\nconst tag = (xml, t) => {\n  const m = xml.match(new RegExp('<' + t + '(?:\\\\s[^>]*)?>([\\\\s\\\\S]*?)<\\\\/' + t + '>', 'i'));\n  return m ? decode(m[1]).trim() : '';\n};\nconst out = [];\nfor (const item of $input.all()) {\n  const xml = typeof item.json.data === 'string' ? item.json.data : (item.json.body || '');\n  if (!xml || xml.indexOf('<item') === -1) continue;\n  const canal = tag(xml.split(/<item(?:\\s[^>]*)?>/i)[0], 'title');\n  const blocos = xml.split(/<item(?:\\s[^>]*)?>/i).slice(1);\n  for (const b of blocos) {\n    const corpo = b.split(/<\\/item>/i)[0];\n    const pub = tag(corpo, 'pubDate');\n    let iso = '';\n    if (pub) { const d = new Date(pub); if (!isNaN(d)) iso = d.toISOString(); }\n    const cats = [...corpo.matchAll(/<category(?:\\s[^>]*)?>([\\s\\S]*?)<\\/category>/gi)].map(m => decode(m[1]).trim());\n    const desc = tag(corpo, 'description') || tag(corpo, 'content:encoded');\n    const fonte = tag(corpo, 'source') || canal;\n    out.push({ json: {\n      title: tag(corpo, 'title').replace(/\\s+-\\s+[^-]{2,40}$/, ''),\n      link: tag(corpo, 'link') || (corpo.match(/<guid[^>]*>([^<]+)<\\/guid>/i) || [,''])[1].trim(),\n      pubDate: pub, isoDate: iso,\n      contentSnippet: desc.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().substring(0, 600),\n      categories: cats,\n      source: fonte\n    }});\n  }\n}\nreturn out;\n"
      },
      "id": "351985b5-0ed8-4d24-a647-7c94b48259e6",
      "name": "Parsear RSS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
