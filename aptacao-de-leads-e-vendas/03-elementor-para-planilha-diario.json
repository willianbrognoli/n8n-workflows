    {
      "parameters": {
        "jsCode": "const existentes = new Set();\nfor (const it of $('Le IDs existentes').all()) {\n  const j = it.json || {};\n  const v = (j.submission_id !== undefined) ? j.submission_id : j.id;\n  if (v !== undefined && v !== null && String(v) !== '') existentes.add(String(v));\n}\nconst saida = [];\nfor (const it of $('Normaliza envios').all()) {\n  const id = String(it.json.submission_id || '');\n  if (!id || !existentes.has(id)) saida.push({ json: it.json });\n}\nreturn saida;"
      },
