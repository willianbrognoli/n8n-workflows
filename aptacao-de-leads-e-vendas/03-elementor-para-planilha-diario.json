    {
      "parameters": {
        "jsCode": "const zone = 'America/Sao_Paulo';\nconst now = DateTime.now().setZone(zone);\nlet ini, fim;\nif ($execution.mode !== 'production') {\n  ini = now.startOf('day');\n  fim = now.endOf('day');\n} else {\n  const ontem = now.minus({ days: 1 });\n  ini = ontem.startOf('day');\n  fim = ontem.endOf('day');\n}\nreturn [{ json: {\n  de: ini.toISO(),\n  ate: fim.toISO(),\n  deMs: ini.toMillis(),\n  ateMs: fim.toMillis(),\n  deGmt: ini.toUTC().toFormat('yyyy-LL-dd HH:mm:ss'),\n  ateGmt: fim.toUTC().toFormat('yyyy-LL-dd HH:mm:ss'),\n  modo: $execution.mode\n} }];"
      },
