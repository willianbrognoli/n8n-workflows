    {
      "parameters": {
        "jsCode": "const zone = 'America/Sao_Paulo';\nconst periodo = $('Define periodo').first().json;\nconst deMs = periodo.deMs;\nconst ateMs = periodo.ateMs;\n\nconst UTM_KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','utm_id','gclid','fbclid','ttclid','msclkid'];\n\nfunction coletaKV(sub) {\n  const kv = {};\n  const add = (k, v) => {\n    if (k === undefined || k === null) return;\n    const key = String(k).trim();\n    if (!key) return;\n    let val = v;\n    if (val && typeof val === 'object') {\n      if ('value' in val) val = val.value; else val = JSON.stringify(val);\n    }\n    if (Array.isArray(val)) val = val.join(', ');\n    kv[key] = (val === undefined || val === null) ? '' : String(val);\n  };\n  const fontes = [sub.values, sub.form_fields, sub.fields, sub.meta];\n  for (const f of fontes) {\n    if (!f) continue;\n    if (Array.isArray(f)) {\n      for (const e of f) { if (e && typeof e === 'object') add(e.key !== undefined ? e.key : (e.id !== undefined ? e.id : e.name), e.value !== undefined ? e.value : (e.title !== undefined ? e.title : '')); }\n    } else if (typeof f === 'object') {\n      for (const [k, v] of Object.entries(f)) add(k, v);\n    }\n  }\n  return kv;\n}\n\nfunction parseData(sub) {\n  const gmt = sub.created_at_gmt;\n  const local = sub.created_at || sub.date;\n  let dt = null;\n  if (gmt) { dt = DateTime.fromSQL(String(gmt), { zone: 'utc' }); if (!dt.isValid) dt = DateTime.fromISO(String(gmt), { zone: 'utc' }); }\n  if ((!dt || !dt.isValid) && local) { dt = DateTime.fromSQL(String(local), { zone: zone }); if (!dt.isValid) dt = DateTime.fromISO(String(local), { zone: zone }); }\n  return (dt && dt.isValid) ? dt : null;\n}\n\nfunction normalizaTelefone(bruto) {\n  let dig = String(bruto || '').replace(/\\D/g, '');\n  if (!dig) return '';\n  dig = dig.replace(/^0+/, '');\n  if (dig.indexOf('55') === 0 && (dig.length === 12 || dig.length === 13)) return dig;\n  if (dig.length === 10 || dig.length === 11) return '55' + dig;\n  return dig;\n}\n\nconst linhas = [];\nfor (const item of $input.all()) {\n  const corpo = item.json || {};\n  const lista = Array.isArray(corpo.data) ? corpo.data : (Array.isArray(corpo) ? corpo : (corpo.id ? [corpo] : []));\n  for (const sub of lista) {\n    const dt = parseData(sub);\n    if (!dt) continue;\n    const ms = dt.toMillis();\n    if (ms < deMs || ms > ateMs) continue;\n\n    const kvOrig = coletaKV(sub);\n    const kvLower = {};\n    for (const [k, v] of Object.entries(kvOrig)) kvLower[k.toLowerCase()] = v;\n\n    const usadas = new Set();\n\n    function achaPorChave(regex) {\n      for (const k of Object.keys(kvLower)) {\n        if (usadas.has(k)) continue;\n        if (regex.test(k)) { usadas.add(k); return kvLower[k]; }\n      }\n      return '';\n    }\n\n    let email = '';\n    for (const k of Object.keys(kvLower)) {\n      const v = kvLower[k];\n      if ((/mail/.test(k) || /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)) && /@/.test(v)) { email = v; usadas.add(k); break; }\n    }\n\n    let telefone = achaPorChave(/(tel|phone|whats|celular|fone)/);\n    if (!telefone) {\n      for (const k of Object.keys(kvLower)) {\n        if (usadas.has(k)) continue;\n        const v = kvLower[k];\n        const dig = v.replace(/\\D/g, '');\n        if (dig.length >= 10 && dig.length <= 14 && /^[\\d\\s()+.\\-]+$/.test(v)) { telefone = v; usadas.add(k); break; }\n      }\n    }\n    telefone = normalizaTelefone(telefone);\n\n    let nomeCompleto = '';\n    for (const k of Object.keys(kvLower)) {\n      if (usadas.has(k)) continue;\n      if (/(^|[_\\s-])(nome|name|first)/.test(k) && !/form/.test(k) && !/(sobrenome|last)/.test(k)) { nomeCompleto = kvLower[k]; usadas.add(k); break; }\n    }\n    let sobrenome = '';\n    for (const k of Object.keys(kvLower)) {\n      if (usadas.has(k)) continue;\n      if (/(sobrenome|last[_\\s-]?name|surname)/.test(k)) { sobrenome = kvLower[k]; usadas.add(k); break; }\n    }\n    let primeiroNome = nomeCompleto;\n    if (!sobrenome && nomeCompleto.indexOf(' ') > -1) {\n      const partes = nomeCompleto.trim().split(/\\s+/);\n      primeiroNome = partes.shift();\n      sobrenome = partes.join(' ');\n    }\n\n    let pagina = '';\n    const candidatos = [sub.referer, sub.page && sub.page.url, kvLower['page_url'], kvLower['referer'], kvLower['referrer'], kvLower['url']];\n    for (const cand of candidatos) {\n      if (cand && /^https?:\\/\\//.test(String(cand))) { pagina = String(cand); break; }\n    }\n\n    const utms = {};\n    for (const uk of UTM_KEYS) {\n      if (kvLower[uk] !== undefined && kvLower[uk] !== '') { utms[uk] = kvLower[uk]; usadas.add(uk); }\n    }\n    const urlsPossiveis = [pagina];\n    for (const v of Object.values(kvLower)) { if (/^https?:\\/\\/.+utm_/.test(v)) urlsPossiveis.push(v); }\n    for (const u of urlsPossiveis) {\n      if (!u) continue;\n      try {\n        const parsed = new URL(u);\n        for (const uk of UTM_KEYS) {\n          const qv = parsed.searchParams.get(uk);\n          if (!utms[uk] && qv) utms[uk] = qv;\n        }\n      } catch (e) {}\n    }\n\n    const extras = {};\n    for (const [k, v] of Object.entries(kvLower)) {\n      if (!usadas.has(k) && v !== '') extras[k] = v;\n    }\n\n    const formulario = (sub.form && (sub.form.name || sub.form.title)) || sub.form_name || kvLower['form_name'] || '';\n\n    linhas.push({ json: {\n      data_hora: dt.setZone(zone).toFormat('dd/LL/yyyy HH:mm:ss'),\n      formulario: String(formulario),\n      primeiro_nome: primeiroNome || '',\n      sobrenome: sobrenome || '',\n      email: email || '',\n      telefone: telefone || '',\n      utm_source: utms.utm_source || '',\n      utm_medium: utms.utm_medium || '',\n      utm_campaign: utms.utm_campaign || '',\n      utm_term: utms.utm_term || '',\n      utm_content: utms.utm_content || '',\n      utm_id: utms.utm_id || '',\n      gclid: utms.gclid || '',\n      fbclid: utms.fbclid || '',\n      pagina: pagina,\n      submission_id: String(sub.id !== undefined ? sub.id : ''),\n      extras: Object.keys(extras).length ? JSON.stringify(extras) : ''\n    } });\n  }\n}\nreturn linhas;"
      },
