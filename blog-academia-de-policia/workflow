    {
      "parameters": {
        "jsCode": "// Junta os feeds, mantém só GUARDA MUNICIPAL das últimas 48h com sinal de edital/andamento\nconst items = $input.all().map(i => i.json);\nconst cfg = $('Config Notícias').first().json;\n\nconst GCM = /guarda\\s+(civil\\s+)?municipal|guardas\\s+(civis\\s+)?municipais|\\bgcm\\b|\\bgm\\s+de\\b|guarda\\s+civil\\b/i;\nconst SINAL = /edital|inscri[cç][aãoõ]|concurso|vagas|banca|prova|gabarito|resultado|convoca|autoriz|publicad|homolog|curso\\s+de\\s+forma[cç][aã]o|taf\\b/i;\nconst EXCLUIR = /guarda\\s+(mirim|noturn|patrimonial|portu[aá]ri|de\\s+endemias)|vigilante\\b|\\bpm\\b\\s+(?!.*guarda)/i;\nconst now = Date.now();\nconst H48 = 48 * 60 * 60 * 1000;\n\nconst news = items.map(it => ({\n  titulo: (it.title || '').trim(),\n  link: it.link || '',\n  data: it.isoDate || it.pubDate || '',\n  resumo: (it.contentSnippet || it.content || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().substring(0, 400),\n  categorias: Array.isArray(it.categories) ? it.categories.map(c => (typeof c === 'string' ? c : (c && c._) || '')).join(', ') : '',\n  fonte: it.source || ''\n})).filter(n => {\n  if (!n.titulo || !n.link) return false;\n  const t = n.data ? new Date(n.data).getTime() : 0;\n  if (t && (now - t) > H48) return false;\n  const txt = n.titulo + ' ' + n.resumo;\n  if (!GCM.test(txt)) return false;\n  if (EXCLUIR.test(n.titulo)) return false;\n  return SINAL.test(txt);\n});\n\n// dedupe por título\nconst seen = new Set();\nconst unicas = news.filter(n => {\n  const k = n.titulo.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '').substring(0, 60);\n  if (seen.has(k)) return false;\n  seen.add(k); return true;\n}).slice(0, 20);\n\nif (unicas.length === 0) return []; // nenhuma notícia de GCM hoje — encerra\n\nreturn [{ json: {\n  noticias: unicas,\n  cfgRaw: cfg\n}}];\n"
      },
      "id": "f5112265-a8b2-4bc8-a928-97ee7cb1d6c8",
      "name": "Filtrar Notícias",
