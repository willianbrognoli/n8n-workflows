        "jsCode": "// Limpa o HTML do Claude e monta o corpo do post WordPress (RANK MATH)\nconst response = $input.first().json;\nconst prev = $('Montar Claude').first().json;\n\nlet html = '';\nif (response.content && Array.isArray(response.content)) {\n  html = response.content.filter(b => b.type === 'text').map(b => b.text).join('');\n} else if (typeof response.content === 'string') {\n  html = response.content;\n}\nhtml = html.replace(/```html\\n?/g, '').replace(/```\\n?/g, '').trim();\n\n// Remove qualquer <style> gerado por engano (o CSS mora no tema WordPress)\nhtml = html.replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '');\nhtml = html.replace(/data-theme=\"[^\"]*\"/gi, '');\nhtml = html.replace(/<script(?![^>]*ld\\+json)[\\s\\S]*?<\\/script>/gi, '');\n\nlet bodyContent = html;\nconst bodyMatch = html.match(/<body[^>]*>([\\s\\S]*)<\\/body>/i);\nif (bodyMatch) bodyContent = bodyMatch[1].trim();\n\nlet schemaBlocks = '';\nconst schemaMatches = bodyContent.match(/<script type=\"application\\/ld\\+json\">[\\s\\S]*?<\\/script>/gi);\nif (schemaMatches) {\n  schemaBlocks = schemaMatches.join('\\n');\n  for (const s of schemaMatches) bodyContent = bodyContent.replace(s, '');\n}\n\nlet wpContent = `<!-- wp:html -->\n${schemaBlocks}\n<div class=\"ap-doc\">\n${bodyContent}\n</div>\n<!-- /wp:html -->`;\n\n// === SEO RANK MATH ===\nconst normalizar = (s) => String(s).toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim();\n\nconst assunto = prev.assunto || 'artigo';\nconst kwBase = normalizar(prev.palavra_chave || assunto);\n\n// Descobre como a palavra-chave aparece ACENTUADA no texto do artigo\nconst textoVisivel = bodyContent.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\nlet mapa = [], normalizado = '';\nfor (let i = 0; i < textoVisivel.length; i++) {\n  const ch = textoVisivel[i].toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  for (let k = 0; k < ch.length; k++) { normalizado += ch[k]; mapa.push(i); }\n}\nlet focusKw = kwBase;\nlet kwOriginal = kwBase;\nconst pos = normalizado.indexOf(kwBase);\nif (pos !== -1) {\n  const ini = mapa[pos];\n  const fim = mapa[Math.min(pos + kwBase.length - 1, mapa.length - 1)] + 1;\n  const trecho = textoVisivel.substring(ini, fim).trim();\n  if (normalizar(trecho) === kwBase) {\n    focusKw = trecho.toLowerCase();\n    kwOriginal = trecho;\n  }\n}\n\nconst slug = kwBase\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-|-$/g, '')\n  .replace(/-?20\\d{2}$/, '');\n\n// título do post = h1 gerado pelo Claude\nlet postTitle = assunto;\nconst h1m = bodyContent.match(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/i);\nif (h1m) postTitle = h1m[1].replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\n\n// === TÍTULO SEO ===\nconst ano = new Date().getFullYear();\nconst capitalizar = (s) => s.charAt(0).toUpperCase() + s.slice(1);\nconst kwTitulo = capitalizar(kwOriginal);\n\nlet complemento = '';\nconst tituloNorm = normalizar(postTitle);\nconst idxKw = tituloNorm.indexOf(kwBase);\nif (idxKw !== -1) {\n  complemento = postTitle.substring(idxKw + kwBase.length).replace(/^[\\s:\\-–—,|]+/, '').trim();\n}\ncomplemento = complemento\n  .replace(/\\s*[—–]\\s*.*$/, '')\n  .replace(/^[\\s:\\-–—,|]+/, '')\n  .replace(/^20\\d{2}[\\s:,-]*/, '')\n  .trim();\nif (normalizar(complemento).includes(kwBase)) complemento = '';\nif (complemento.length > 32) {\n  complemento = complemento.substring(0, 32).replace(/\\s+\\S*$/, '').trim();\n}\nconst complementoTemAno = /20\\d{2}/.test(complemento);\n\nlet seoTitle = complemento\n  ? `${kwTitulo}: ${complemento}${complementoTemAno ? '' : ' ' + ano}`\n  : (prev.tipo === 'noticia'\n      ? `${kwTitulo}: edital e vagas ${ano}`\n      : `${kwTitulo}: guia completo ${ano}`);\n\nif (seoTitle.length > 60) {\n  const sufixo = ` ${ano}`;\n  const espaco = 60 - kwTitulo.length - 2 - sufixo.length;\n  let comp = complemento.substring(0, Math.max(0, espaco));\n  comp = comp.replace(/\\s+\\S*$/, '').trim();\n  seoTitle = comp ? `${kwTitulo}: ${comp}${sufixo}` : `${kwTitulo}${sufixo}`;\n}\n\nconst secondaryKws = [\n  focusKw,\n  `${focusKw} ${ano}`,\n  prev.tipo === 'noticia' ? `${focusKw} edital` : `${focusKw} concurso`,\n  prev.tipo === 'noticia' ? `${focusKw} vagas` : `${focusKw} guarda municipal`\n].filter((v, i, a) => v && a.indexOf(v) === i).join(',');\n\n// meta description do primeiro parágrafo\nlet metaDesc = '';\nconst pm = bodyContent.match(/<p[^>]*class=\"[^\"]*intro-prof__lead[^\"]*\"[^>]*>([\\s\\S]*?)<\\/p>/i) ||\n           bodyContent.match(/<p[^>]*>([\\s\\S]*?)<\\/p>/i);\nif (pm) metaDesc = pm[1].replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\nif (!metaDesc || metaDesc.length < 100 || !normalizar(metaDesc).includes(kwBase)) {\n  metaDesc = prev.tipo === 'noticia'\n    ? `${kwTitulo}: vagas, banca, salário, etapas e o que estudar. Análise da Academia de Polícia, especialista em GCM.`\n    : `${kwTitulo}: entenda o tema, veja como as bancas cobram e prepare-se com a Academia de Polícia, especialista em GCM.`;\n}\nif (metaDesc.length > 155) metaDesc = metaDesc.substring(0, 152) + '...';\n\n// Rank Math exige ao menos uma imagem no conteúdo com alt contendo a palavra-chave.\n// A skill já gera a assinatura da Academia; se ela faltar, injetamos aqui.\nconst LOGO = prev.cfg.LOGO_URL || 'https://academiadepolicia.com.br/wp-content/uploads/2026/04/brasao-academia-de-policia-em-fundo.png';\nif (!/<img[^>]+alt=/i.test(bodyContent)) {\n  const assinatura = `\n<section class=\"ap-bloco\"><div class=\"ap-larg\"><div class=\"ap-assinatura\">\n  <img src=\"${LOGO}\" width=\"62\" height=\"62\" loading=\"lazy\" alt=\"${focusKw} — Academia de Policia\">\n  <div><h3>Academia de Policia</h3><p>A unica escola do Brasil focada exclusivamente em concursos de Guarda Municipal. Cinco professores especialistas, videoaulas de ate 15 minutos, apostilas, caderno de exercicios e mapas mentais para qualquer GCM do pais.</p></div>\n</div></div></section>`;\n  const fecho = wpContent.lastIndexOf('</div>');\n  if (fecho !== -1) wpContent = wpContent.substring(0, fecho) + assinatura + wpContent.substring(fecho);\n}\n\n// Remove ✓ digitado no texto dos <li> (o CSS já insere o marcador)\nwpContent = wpContent.replace(/(<li[^>]*>)\\s*✓\\s*/g, '$1');\nwpContent = wpContent.replace(/(<b>)\\s*✓\\s*/g, '$1');\n\n// Achatar em linha única: imune ao wpautop do WordPress\nconst wpContentFlat = wpContent.replace(/\\r/g, '').replace(/\\s*\\n+\\s*/g, ' ').trim();\n\n// Categoria conforme a origem: notícia (RSS) ou matéria (planilha)\nconst catId = prev.tipo === 'noticia'\n  ? (prev.cfg.CAT_NOTICIAS || 60)\n  : (prev.cfg.CAT_MATERIA || 61);\n\n// Tag do estado: alimenta o filtro por estado da listagem do blog\nconst tagsPost = [];\nif (prev.uf && prev.uf !== 'nacional') {\n  const mapaUf = prev.cfg.TAGS_UF || {};\n  const tagUf = mapaUf[prev.uf];\n  if (tagUf) tagsPost.push(tagUf);\n}\n\nconst wpBody = JSON.stringify({\n  title: postTitle,\n  categories: [catId],\n  tags: tagsPost,\n  slug: slug,\n  content: wpContentFlat,\n  status: (prev.cfg.WP_STATUS === 'draft' ? 'draft' : 'publish'),\n  meta: {\n    rank_math_title: seoTitle,\n    rank_math_description: metaDesc,\n    rank_math_focus_keyword: focusKw,\n    rank_math_secondary_keywords: secondaryKws\n  }\n});\n\nreturn [{ json: {\n  wp_url: prev.cfg.wpUrl,\n  wp_body: wpBody,\n  tipo: prev.tipo,\n  uf: prev.uf || null,\n  cidade: prev.cidade || null,\n  assunto,\n  palavra_chave: focusKw,\n  rowIndex: prev.rowIndex,\n  sheetsUrl: prev.sheetsUrl,\n  cfg: prev.cfg,\n  _seo_debug: { focusKw, secondaryKws, seoTitle, metaDesc, slug, postTitle, catId, tagsPost }\n}}];\n"
