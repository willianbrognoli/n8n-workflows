      "id": "cb31227a-845c-4f85-a567-54795969ec21",
      "name": "Busca envios Elementor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "httpBasicAuth": {
          "id": "CREDENTIAL_ID",
