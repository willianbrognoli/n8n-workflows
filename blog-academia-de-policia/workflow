        "jsCode": "// Escolhe o post publicado mais recente que ainda não virou carrossel\nconst cfg = $('Config IG').first().json;\nif (!Number(cfg.TAG_IG_OK)) {\n  throw new Error('Configure TAG_IG_OK no nó Config IG com o ID da tag \"ig-ok\" do WordPress. Sem isso o mesmo post seria publicado no Instagram várias vezes.');\n}\nconst posts = $input.all().map(i => i.json).filter(p => p && p.id);\n\nconst alvo = posts.find(p => {\n  const cats = p.categories || [];\n  const tags = p.tags || [];\n  const origem = cats.includes(cfg.CAT_NOTICIAS) || cats.includes(cfg.CAT_MATERIA);\n  const feito = tags.includes(cfg.TAG_IG_OK);\n  const dias = (Date.now() - new Date(p.date).getTime()) / 86400000;\n  return origem && !feito && dias <= 5;\n});\nif (!alvo) return []; // nada pendente — encerra em silêncio\n\nconst texto = String((alvo.content && alvo.content.rendered) || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ').trim();\n\nreturn [{ json: {\n  cfg,\n  postId: alvo.id,\n  titulo: String(alvo.title.rendered).replace(/<[^>]+>/g, '').trim(),\n  link: alvo.link,\n  tagsAtuais: alvo.tags || [],\n  tipo: (alvo.categories || []).includes(cfg.CAT_NOTICIAS) ? 'noticia' : 'tema',\n  texto: texto.substring(0, 9000)\n}}];\n"
      },
