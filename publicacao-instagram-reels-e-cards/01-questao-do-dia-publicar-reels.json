    {
      "id": "0975899f-0f8e-41c8-97a5-9c6ead2dc4e9",
      "name": "Buscar Video Pronto",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        620,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "ID_DATA_TABLE",
          "cachedResultName": "questao_dia_controle"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pronto"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "orderBy": true,
        "orderByColumn": "numero",
        "orderByDirection": "ASC"
      }
    },
    {
      "id": "eab17c15-6ff3-4901-9bc7-301d3057d0e0",
      "name": "Preparar Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst linhas = $input.all();\nif (linhas.length === 0) { return []; }\nconst q = linhas[0].json;\nconst cfg = $('Config Publicacao').first().json;\nif (!q.video_drive_id) {\n  throw new Error('Questao ' + q.numero + ' esta como pronto mas sem video_drive_id na tabela');\n}\nlet caption = String(q.legenda || '').trim();\nif (caption.length < 50) {\n  caption = 'Questao de etica pra concurso: ' + q.banca + ' ' + q.orgao + ' cobrou e muita gente escorregou. '\n    + 'Julgue o item do video: CERTO ou ERRADO? Responde nos comentarios ANTES de ver o gabarito. '\n    + 'A resposta comentada esta no comentario fixado. '\n    + 'Siga @proftiagozanolla para a Questao do Dia, de segunda a sexta.\\n\\n'\n    + '#concursopublico #concursos #eticanoservicopublico #decreto1171 #questaododia #cebraspe #quadrix #dicasdeconcursos #concurseiros #aprovacao';\n}\ncaption = caption.replace(/\\s+\\u2014\\s+/g, ': ').replace(/[\\u2014\\u2013]/g, ', ');\nreturn [{ json: {\n  row_id: q.id,\n  numero: q.numero,\n  video_drive_id: q.video_drive_id,\n  caption,\n  igUserId: cfg.igUserId,\n  pageToken: cfg.pageToken,\n  apiVersion: cfg.apiVersion,\n  cloudName: cfg.cloudName,\n  uploadPreset: cfg.uploadPreset,\n} }];\n"
      }
    },
    {
      "id": "8abfaab3-a858-4f92-ab73-7e10172e9b74",
      "name": "Baixar Video Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.video_drive_id }}?alt=media",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 180000
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "CREDENTIAL_ID",
          "name": "Google Drive account"
        }
      }
    },
    {
      "id": "a39a9add-3b28-4cd4-a75b-25f7982570ba",
      "name": "Video para Base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1220,
        300
      ],
      "parameters": {
        "operation": "binaryToPropery",
        "destinationKey": "b64"
      }
    },
    {
      "id": "770e0e8a-830f-4893-a203-1ca7f36f2ab3",
      "name": "Subir Cloudinary Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1420,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudinary.com/v1_1/{{ $('Preparar Item').item.json.cloudName }}/video/upload",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "=data:video/mp4;base64,{{ $json.b64 }}"
            },
            {
              "name": "upload_preset",
              "value": "={{ $('Preparar Item').item.json.uploadPreset }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "93f8edde-ddc1-4122-baaf-33059d915c87",
      "name": "IG Criar Container Reels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst d = $('Preparar Item').first().json;\nconst cloud = $input.first().json;\nif (!cloud.secure_url) {\n  throw new Error('Cloudinary nao devolveu secure_url: ' + JSON.stringify(cloud).slice(0, 300));\n}\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://graph.facebook.com/' + d.apiVersion + '/' + d.igUserId + '/media',\n  qs: {\n    media_type: 'REELS',\n    video_url: cloud.secure_url,\n    caption: d.caption,\n    share_to_feed: 'true',\n    access_token: d.pageToken,\n  },\n});\nif (!response.id) {\n  throw new Error('Falha ao criar container IG: ' + JSON.stringify(response));\n}\nreturn [{ json: { ...d, video_url: cloud.secure_url, container_id: response.id } }];\n"
      }
    },
    {
      "id": "c6fe7939-f674-4fdd-b4e0-1d4c49a5b33a",
      "name": "Aguardar Processamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst d = $input.first().json;\nconst maxTentativas = 60;\nfor (let i = 0; i < maxTentativas; i++) {\n  const st = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://graph.facebook.com/' + d.apiVersion + '/' + d.container_id,\n    qs: { fields: 'status_code', access_token: d.pageToken },\n  });\n  if (st.status_code === 'FINISHED') {\n    return [{ json: d }];\n  }\n  if (st.status_code === 'ERROR' || st.status_code === 'EXPIRED') {\n    throw new Error('Container IG com status ' + st.status_code + ' na questao ' + d.numero);\n  }\n  await new Promise(r => setTimeout(r, 5000));\n}\nthrow new Error('Video da questao ' + d.numero + ' nao processou em tempo habil');\n"
      }
    },
    {
      "id": "5702ca5a-c10c-4902-9011-f6c630e87143",
      "name": "IG Publicar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst d = $input.first().json;\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://graph.facebook.com/' + d.apiVersion + '/' + d.igUserId + '/media_publish',\n  qs: { creation_id: d.container_id, access_token: d.pageToken },\n});\nif (!response.id) {\n  throw new Error('Falha ao publicar no IG: ' + JSON.stringify(response));\n}\nreturn [{ json: { row_id: d.row_id, numero: d.numero, ig_id: response.id } }];\n"
      }
    },
