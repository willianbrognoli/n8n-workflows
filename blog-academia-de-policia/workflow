    {
      "parameters": {
        "jsCode": "// Capa do post — identidade \"briefing operacional\" da Academia de Polícia\nconst d = $input.first().json;\nconst tipo = d.tipo === 'noticia' ? 'noticia' : 'tema';\nconst brasao = d.cfg.LOGO_URL || 'https://academiadepolicia.com.br/wp-content/uploads/2026/04/brasao-academia-de-policia-em-fundo.png';\nconst modelo = tipo === 'noticia' ? (d.cfg.CAPA_MODELO_NOTICIA || '') : (d.cfg.CAPA_MODELO_TEMA || '');\n\nconst esc = (s) => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nconst bruto = String(d.assunto || 'Concurso Guarda Municipal').trim().replace(/R\\$\\s+/gi, 'R$\\u00A0');\nlet titulo = bruto, apoio = '';\nconst sep = bruto.match(/^(.+?)\\s*[:—–|]\\s*(.+)$/);\nif (sep) {\n  titulo = sep[1].trim();\n  apoio = sep[2].trim().split(/\\s*[—–]\\s*/)[0];\n}\nif (apoio.length > 62) {\n  const palavras = apoio.split(/ +/);\n  let acc = '';\n  for (const p of palavras) { if ((acc + ' ' + p).trim().length > 58) break; acc = (acc + ' ' + p).trim(); }\n  apoio = acc;\n}\n\n// etiqueta e localidade\nconst etiqueta = tipo === 'noticia' ? 'BRIEFING · CONCURSO GCM' : 'BRIEFING · GUARDA MUNICIPAL';\nconst local = tipo === 'noticia'\n  ? (d.cidade ? `${String(d.cidade).toUpperCase()}${d.uf && d.uf !== 'nacional' ? ' / ' + String(d.uf).toUpperCase() : ''}` : 'BRASIL')\n  : String(d.categoria || 'PREPARAÇÃO').toUpperCase();\n\nconst quebrar = (txt, maxLinhas) => {\n  const palavras = txt.split(/ +/).filter(Boolean);\n  if (palavras.length <= 1) return palavras;\n  let melhor = null;\n  for (let linhas = 1; linhas <= maxLinhas; linhas++) {\n    const alvo = Math.ceil(txt.length / linhas);\n    const res = []; let atual = '';\n    for (const p of palavras) {\n      if (!atual) { atual = p; continue; }\n      if ((atual + ' ' + p).length <= alvo + 4) atual += ' ' + p;\n      else { res.push(atual); atual = p; }\n    }\n    if (atual) res.push(atual);\n    if (res.length <= linhas) {\n      const maxLen = Math.max(...res.map(l => l.length));\n      if (!melhor || maxLen < melhor.maxLen) melhor = { linhas: res, maxLen };\n      if (maxLen <= 22) break;\n    }\n  }\n  return melhor ? melhor.linhas : [txt];\n};\n\nconst linhas = quebrar(titulo, 3);\nconst maiorLinha = Math.max(...linhas.map(l => l.length));\n// bloco de texto ocupa ~62vw; Space Grotesk 700 caixa mista ≈ 0.50em por caractere\nlet fontTitulo = 60 / (maiorLinha * 0.50);\nfontTitulo = Math.max(3.0, Math.min(fontTitulo, linhas.length >= 3 ? 5.4 : 6.6));\nconst fontApoio = Math.max(1.7, Math.min(fontTitulo * 0.40, 2.4));\nconst fmt = (n) => Number(n).toFixed(2);\n\nconst html = `<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  @font-face { font-family:'AP Head'; font-weight:700; font-display:block;\n    src:url(data:font/woff2;base64,) format('woff2'); }\n  @font-face { font-family:'AP Body'; font-weight:400; font-display:block;\n    src:url(data:font/woff2;base64,) format('woff2'); }\n  * { margin:0; padding:0; box-sizing:border-box; }\n  html, body { width:100vw; height:100vh; overflow:hidden; background:#0b0b0b; }\n  .quadro {\n    position:relative; width:100vw; height:100vh; overflow:hidden;\n    background: linear-gradient(180deg,#0b0b0b 0%,#141006 62%,#0b0b0b 100%);\n    ${modelo ? `background-image:url('${modelo}'); background-size:cover; background-position:center;` : ''}\n    display:flex; flex-direction:column;\n  }\n  .luz { position:absolute; inset:0; background:radial-gradient(ellipse 90% 70% at 50% 118%, rgba(212,175,55,.22) 0%, transparent 62%); }\n  .cabeca {\n    position:relative; display:flex; align-items:center; justify-content:space-between;\n    padding:2.6vh 4vw; border-bottom:1px solid rgba(212,175,55,.28);\n  }\n  .cabeca .marca { display:flex; align-items:center; gap:1.1vw; font-family:'AP Head',sans-serif; font-weight:700; font-size:1.9vw; color:#fff; }\n  .cabeca .marca img { height:6.4vh; }\n  .cabeca .marca i { font-style:normal; font-size:1.1vw; letter-spacing:.2em; color:#D4AF37; }\n  .cabeca .ref { font-family:'AP Body',sans-serif; font-size:1.15vw; letter-spacing:.14em; color:rgba(232,229,227,.42); text-transform:uppercase; }\n  .agua { position:absolute; right:-2vw; top:50%; transform:translateY(-46%); height:76vh; opacity:.13; filter:grayscale(.2); pointer-events:none; }\n  .miolo { position:relative; flex:1; display:flex; flex-direction:column; justify-content:center; padding:0 4vw; }\n  .etiqueta {\n    display:inline-flex; align-items:center; gap:.9vw; align-self:flex-start;\n    font-family:'AP Body',sans-serif; font-size:1.25vw; letter-spacing:.16em; text-transform:uppercase;\n    color:#D4AF37; border:1px solid rgba(212,175,55,.4); padding:.7vw 1.4vw; margin-bottom:2.6vh;\n  }\n  .etiqueta b { color:#fff; font-weight:400; }\n  .titulo {\n    font-family:'AP Head',sans-serif; font-weight:700; letter-spacing:-.018em;\n    font-size:${fmt(fontTitulo)}vw; line-height:1.1; color:#ffffff; white-space:nowrap;\n  }\n  .titulo.d { color:#D4AF37; }\n  .apoio { font-family:'AP Body',sans-serif; font-size:${fmt(fontApoio)}vw; line-height:1.4; color:rgba(232,229,227,.72); margin-top:2.4vh; max-width:62vw; }\n  .rodape {\n    position:relative; display:flex; align-items:center; justify-content:space-between;\n    padding:2.4vh 4vw; border-top:2px solid #D4AF37;\n  }\n  .rodape .site { font-family:'AP Head',sans-serif; font-weight:700; font-size:1.5vw; letter-spacing:.02em; color:#fff; }\n  .rodape .site b { color:#D4AF37; }\n  .rodape .nota { font-family:'AP Body',sans-serif; font-size:1.15vw; letter-spacing:.14em; text-transform:uppercase; color:rgba(232,229,227,.42); }\n</style>\n</head>\n<body>\n  <div class=\"quadro\">\n    <div class=\"luz\"></div>\n    <img class=\"agua\" src=\"${brasao}\">\n    <div class=\"cabeca\">\n      <div class=\"marca\"><img src=\"${brasao}\"> Academia de Polícia <i>GCM</i></div>\n      <div class=\"ref\">${esc(local)}</div>\n    </div>\n    <div class=\"miolo\">\n      <div class=\"etiqueta\">${esc(etiqueta)}</div>\n      ${linhas.map((l, i) => `<div class=\"titulo${i === linhas.length - 1 ? ' d' : ''}\">${esc(l)}</div>`).join('\\n      ')}\n      ${apoio ? `<div class=\"apoio\">${esc(apoio)}</div>` : ''}\n    </div>\n    <div class=\"rodape\">\n      <div class=\"site\">academiadepolicia<b>.com.br</b></div>\n      <div class=\"nota\">Especialistas em Guarda Municipal</div>\n    </div>\n  </div>\n</body>\n</html>`;\n\nconst slug = String(d.assunto).toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').substring(0, 40);\n\nreturn [{ json: {\n  renders: [{ name: `capa_blog_${slug}`, html, width: 1200, height: 675 }],\n  postId: d.postId, wpUrl: d.wpUrl, assunto: d.assunto, palavra_chave: d.palavra_chave,\n  tipo: d.tipo, uf: d.uf, cidade: d.cidade, rowIndex: d.rowIndex, sheetsUrl: d.sheetsUrl,\n  cfg: d.cfg, postUrl: d.postUrl,\n  _debug: { titulo, apoio, linhas, fontTitulo, etiqueta, local }\n}}];\n"
      },
