        "jsCode": "// Extrai dossiê + JSON estruturado da resposta do Perplexity\nconst response = $input.first().json;\nconst prev = $('Montar Perplexity').first().json;\n\nconst content = response.choices?.[0]?.message?.content || '';\nconst citations = response.citations || (response.search_results || []).map(s => s.url) || [];\n\nlet pesquisa = null;\nlet dossie = content;\n\nconst jsonMatches = content.match(/\\{[\\s\\S]*\\}/g);\nif (jsonMatches && jsonMatches.length > 0) {\n  let best = jsonMatches[0];\n  for (const m of jsonMatches) { if (m.length > best.length) best = m; }\n  try {\n    pesquisa = JSON.parse(best.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim());\n    const idx = content.indexOf(best);\n    if (idx > 0) dossie = content.substring(0, idx).trim();\n  } catch (e) {\n    try {\n      const fb = content.indexOf('{');\n      const lb = content.lastIndexOf('}');\n      if (fb !== -1 && lb > fb) pesquisa = JSON.parse(content.substring(fb, lb + 1));\n    } catch (e2) {}\n  }\n}\n\nif (!pesquisa) pesquisa = {};\npesquisa.palavra_chave = pesquisa.palavra_chave || prev.palavra_chave;\n\n// se a pesquisa identificou cidade/UF melhor que a seleção, aproveita\nconst uf = prev.uf || (pesquisa.uf ? String(pesquisa.uf).toLowerCase() : null);\nconst cidade = prev.cidade || pesquisa.cidade || null;\n\nreturn [{ json: {\n  ...prev,\n  uf,\n  cidade,\n  requestBody: undefined,\n  pesquisa,\n  pesquisa_json: JSON.stringify(pesquisa, null, 2),\n  dossie_completo: dossie,\n  fontes: citations\n}}];\n"
