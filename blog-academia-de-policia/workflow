        "jsCode": "// Valida os 8 temas, remove duplicatas e prepara as linhas novas\nconst prev = $('Montar Sugestões Pauta').first().json;\nconst resp = $input.first().json;\nlet texto = (((resp.content || [])[0] || {}).text || '').trim();\ntexto = texto.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '').trim();\nconst ini = texto.indexOf('['), fim = texto.lastIndexOf(']');\nif (ini === -1 || fim <= ini) throw new Error('Claude não devolveu um array JSON');\nconst sugestoes = JSON.parse(texto.substring(ini, fim + 1));\n\nconst norm = (s) => String(s || '').toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9 ]+/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst existentes = new Set(prev.temasAtuais.map(norm));\nconst CATS = new Set(['Legislação GCM', 'Disciplinas', 'Preparação', 'Carreira']);\nconst vistos = new Set();\nconst linhas = [];\nfor (const s of sugestoes) {\n  const tema = String(s.tema || '').trim();\n  const chave = norm(tema);\n  if (!tema || !chave) continue;\n  if (existentes.has(chave) || vistos.has(chave)) continue;\n  vistos.add(chave);\n  linhas.push({ json: {\n    tema,\n    categoria: CATS.has(String(s.categoria).trim()) ? String(s.categoria).trim() : 'Legislação GCM',\n    foco: String(s.foco || '').trim(),\n    palavra_chave: norm(s.palavra_chave || tema)\n  }});\n  if (linhas.length >= 8) break;\n}\nif (!linhas.length) return [];\nreturn linhas;\n"
