      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prev = $('Montar Roteiro').first().json;\nlet t = '';\nif (resp.content && Array.isArray(resp.content)) t = resp.content.filter(b=>b.type==='text').map(b=>b.text).join('');\nt = t.replace(/```json\\n?/g,'').replace(/```\\n?/g,'').trim();\nlet roteiro;\ntry { roteiro = JSON.parse(t); }\ncatch(e) { const m = t.match(/\\{[\\s\\S]*\\}/); if (m) roteiro = JSON.parse(m[0]); else throw new Error('Roteiro inválido: '+t.substring(0,300)); }\nif (!Array.isArray(roteiro.pontos) || roteiro.pontos.length < 2) throw new Error('Roteiro sem pontos suficientes');\nroteiro.pontos = roteiro.pontos.slice(0, 5);\nreturn [{ json: { ...prev, requestBody: undefined, roteiro } }];\n"
      },
      "id": "f0e93612-1a82-4645-ab78-8d95effd176e",
      "name": "Processar Roteiro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
