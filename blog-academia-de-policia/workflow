    },
    {
      "parameters": {
        "jsCode": "// ═══ SLIDES INSTAGRAM — ACADEMIA DE POLÍCIA ═══\n// Identidade do blog: fundo preto #0e0e0e, dourado #D4AF37, Space Grotesk (AP Head) + Inter (AP Body),\n// brasão em marca d'água, barra dourada no rodapé, última linha do título em dourado.\n// Render em TELA CHEIA: feed 1080x1350, story 1080x1920. O serviço de screenshot devolve 2x;\n// o nó seguinte só redimensiona (nada de corte).\n\nconst FONTES = `\n@font-face{font-family:'AP Head';font-weight:700;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}\n@font-face{font-family:'AP Body';font-weight:400;font-display:block;src:url(data:font/woff2;base64,) format('woff2')}`;\n\nconst OURO = '#D4AF37', FUNDO = '#0e0e0e', BRANCO = '#ffffff';\nconst MEIO = 'rgba(229,226,225,.78)', FRACO = 'rgba(229,226,225,.46)';\n\nconst colar = (s) => String(s||'').replace(/R\\$\\s+/gi, 'R$\\u00A0').replace(/(\\d)\\s+(mil|milh[oõ]es)\\b/gi, '$1\\u00A0$2');\nconst esc = (s) => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nconst STOPFIM = new Set(['de','do','da','dos','das','e','o','a','os','as','em','no','na','nos','nas','para','com','que','ao','à','um','uma','por','se','como','sem','mais','seu','sua','ate','até','apos','após']);\nconst limitar = (txt, max, retic) => {\n  const p = String(txt||'').trim().split(/ +/).filter(Boolean);\n  if (p.length <= max) return p.join(' ');\n  let c = p.slice(0, max);\n  while (c.length > 2 && (STOPFIM.has(c[c.length-1].toLowerCase()) || /^[R$€0-9.,]+$/i.test(c[c.length-1]))) c.pop();\n  return c.join(' ') + (retic ? '…' : '');\n};\n\n// quebra o título em linhas equilibradas (menor linha máxima)\nconst quebrar = (txt, maxL) => {\n  const palavras = String(txt).split(/ +/).filter(Boolean);\n  if (palavras.length <= 1) return palavras.length ? palavras : [''];\n  let melhor = null;\n  for (let L = 1; L <= maxL; L++) {\n    const alvo = Math.ceil(txt.length / L);\n    const res = []; let atual = '';\n    for (const p of palavras) {\n      if (!atual) { atual = p; continue; }\n      if ((atual+' '+p).length <= alvo + 3) atual += ' '+p;\n      else { res.push(atual); atual = p; }\n    }\n    if (atual) res.push(atual);\n    if (res.length <= L) { const m = Math.max(...res.map(x=>x.length)); if (!melhor || m < melhor.m) melhor = { linhas: res, m }; }\n  }\n  return melhor ? melhor.linhas : [String(txt)];\n};\n\n// tamanho da fonte para caber na largura útil (px). Space Grotesk 700 ≈ 0.56em/char em caixa mista\nconst fonteQueCabe = (linhas, larguraPx, min, max, fator = 0.56) => {\n  const maior = Math.max(...linhas.map(l => l.length), 1);\n  return Math.max(min, Math.min(larguraPx / (maior * fator), max));\n};\n\n// escolhe o MENOR número de linhas que ainda permite fonte grande (evita título picado em 4 linhas curtas)\nconst melhorQuebra = (txt, maxL, larguraPx, min, max, fator = 0.56) => {\n  let ultimo = null;\n  for (let L = 1; L <= maxL; L++) {\n    const linhas = quebrar(txt, L);\n    if (linhas.length > L) continue;\n    const font = fonteQueCabe(linhas, larguraPx, min, max, fator);\n    ultimo = { linhas, font };\n    if (font >= max * 0.82) return ultimo;\n  }\n  return ultimo || { linhas: [txt], font: min };\n};\n\n// última linha do título em dourado (como na capa do blog), só quando não é palavra solta\nconst linhasTitulo = (linhas) => linhas.map((l, i) =>\n  `<div${(i === linhas.length-1 && linhas.length > 1 && l.split(' ').length >= 2) ? ' class=\"d\"' : ''}>${esc(l)}</div>`).join('');\n\nconst ajuste = `<script>\n(function(){document.querySelectorAll('[data-fit]').forEach(function(el){\n  var box=el.closest('[data-fitbox]')||el.parentElement, f=parseFloat(getComputedStyle(el).fontSize), min=f*.55, g=80;\n  while(g-->0 && f>min && box.scrollHeight>box.clientHeight+2){f*=.96;el.style.fontSize=f+'px';}});})();\n</script>`;\n\n// ── casca comum (px absolutos, viewport fixo 1080 de largura) ─────────────\nconst shell = (inner, css, altura) => `<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"UTF-8\"><style>\n${FONTES}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:1080px;height:${altura}px;overflow:hidden;background:${FUNDO}}\nbody{font-family:'AP Body',Inter,sans-serif;color:#e5e2e1;position:relative}\n.fundo{position:absolute;inset:0;background:linear-gradient(180deg,#0e0e0e 0%,#151006 62%,#0e0e0e 100%)}\n.luz{position:absolute;inset:0;background:radial-gradient(ellipse 90% 40% at 50% 104%,rgba(212,175,55,.20) 0%,transparent 64%)}\n.agua{position:absolute;right:-40px;top:50%;transform:translateY(-46%);height:${Math.round(altura*0.42)}px;opacity:.10;z-index:1}\n.topo{position:absolute;top:0;left:0;right:0;height:120px;display:flex;align-items:center;justify-content:space-between;\n  padding:0 72px;border-bottom:1px solid rgba(212,175,55,.28);z-index:3}\n.topo .marca{display:flex;align-items:center;gap:14px;font-family:'AP Head','Space Grotesk',sans-serif;font-weight:700;font-size:28px;color:${BRANCO}}\n.topo .marca img{height:52px}\n.topo .marca i{font-style:normal;font-size:15px;letter-spacing:.2em;color:${OURO};margin-left:4px}\n.topo .ref{font-size:15px;letter-spacing:.16em;text-transform:uppercase;color:${FRACO}}\n.pe{position:absolute;left:0;right:0;bottom:0;height:104px;display:flex;align-items:center;justify-content:space-between;\n  padding:0 72px;border-top:3px solid ${OURO};background:rgba(14,14,14,.6);z-index:3}\n.pe .site{font-family:'AP Head','Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:${BRANCO}}\n.pe .site b{color:${OURO}}\n.pe .nota{font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:${FRACO}}\n.etiqueta{display:inline-flex;align-self:flex-start;font-size:17px;letter-spacing:.16em;text-transform:uppercase;\n  color:${OURO};border:1px solid rgba(212,175,55,.5);padding:11px 20px}\n.titulo{font-family:'AP Head','Space Grotesk',sans-serif;font-weight:700;letter-spacing:-.02em;color:${BRANCO};white-space:nowrap}\n.titulo .d{color:${OURO}}\n${css}\n</style></head><body><div class=\"fundo\"></div><div class=\"luz\"></div>${inner}${ajuste}</body></html>`;\n\nconst topo = (ref, brasao) => `<div class=\"topo\"><div class=\"marca\"><img src=\"${esc(brasao)}\"> Academia de Polícia <i>GCM</i></div><div class=\"ref\">${esc(ref)}</div></div>`;\nconst pe = (nota) => `<div class=\"pe\"><div class=\"site\">academiadepolicia<b>.com.br</b></div><div class=\"nota\">${esc(nota)}</div></div>`;\n\nconst LARG = 1080 - 2*72; // largura útil\n\n// ── capa (feed) ──────────────────────────────────────────────────────────\nfunction capa(d) {\n  const titulo = limitar(colar(d.titulo), 10);\n  const apoio = limitar(colar(d.subtitulo), 12);\n  const { linhas, font } = melhorQuebra(titulo, 4, LARG, 58, 112);\n  return shell(`\n  ${topo(d.local, d.brasao)}\n  <img class=\"agua\" src=\"${esc(d.brasao)}\">\n  <div class=\"miolo\">\n    <div class=\"etiqueta\">${esc(d.etiqueta)}</div>\n    <div class=\"titulo\">${linhasTitulo(linhas)}</div>\n    ${apoio?`<div class=\"apoio\">${esc(apoio)}</div>`:''}\n  </div>\n  <div class=\"arrasta\">Arraste →</div>\n  ${pe(d.nota)}\n  `, `\n  .miolo{position:absolute;left:72px;right:72px;top:120px;bottom:104px;display:flex;flex-direction:column;justify-content:center;z-index:2}\n  .titulo{font-size:${font.toFixed(1)}px;line-height:1.08;margin-top:34px}\n  .apoio{font-size:32px;line-height:1.4;color:${MEIO};margin-top:30px;max-width:820px}\n  .arrasta{position:absolute;right:72px;bottom:130px;font-family:'AP Head','Space Grotesk',sans-serif;font-weight:700;font-size:17px;\n    letter-spacing:.16em;text-transform:uppercase;color:${FRACO};z-index:3}\n  `, 1350);\n}\n\n// ── ponto (feed) ─────────────────────────────────────────────────────────\nfunction ponto(d) {\n  const tit = limitar(colar(d.titulo), 6);\n  const txt = limitar(colar(d.texto), 52, true);\n  const { linhas, font } = melhorQuebra(tit, 3, LARG - 44, 52, 88);\n  const num = String(d.indice).padStart(2,'0');\n  return shell(`\n  ${topo(`${d.selo} · ${num} de ${String(d.total