      "parameters": {
        "jsCode": "// Lê a escolha do Claude e monta o briefing tipo \"noticia\"\nconst resp = $input.first().json;\nconst prev = $('Montar Seleção').first().json;\nconst cfg = prev.cfgRaw;\n\nlet text = '';\nif (resp.content && Array.isArray(resp.content)) {\n  text = resp.content.filter(b => b.type === 'text').map(b => b.text).join('');\n}\ntext = text.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet escolha;\ntry { escolha = JSON.parse(text); }\ncatch (e) {\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  if (m) escolha = JSON.parse(m[0]);\n  else throw new Error('Claude não retornou JSON válido na seleção: ' + text.substring(0, 300));\n}\n\nconst idx = (escolha.indice || 1) - 1;\nconst noticia = prev.noticias[Math.max(0, Math.min(idx, prev.noticias.length - 1))];\n\nconst ufBruta = (escolha.uf || '').toString().trim().toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst UFS_VALIDAS = ['ac','al','ap','am','ba','ce','df','es','go','ma','mt','ms','mg','pa','pb',\n  'pr','pe','pi','rj','rn','rs','ro','rr','sc','sp','se','to','nacional'];\nconst uf = UFS_VALIDAS.includes(ufBruta) ? ufBruta : null;\nconst cidade = (escolha.cidade || '').toString().trim() || null;\n\nreturn [{ json: {\n  tipo: 'noticia',\n  uf,\n  cidade,\n  fase: escolha.fase || '',\n  assunto: escolha.titulo_post || noticia.titulo,\n  categoria: 'Concurso GCM',\n  foco: escolha.justificativa || '',\n  palavra_chave: (escolha.palavra_chave || noticia.titulo).toString().toLowerCase(),\n  contexto: `Notícia-base escolhida: \"${noticia.titulo}\" (${noticia.link}, ${noticia.data}, fonte: ${noticia.fonte || 'n/d'}). Cidade: ${cidade || 'n/d'}${uf ? '/' + uf.toUpperCase() : ''}. Órgão: ${escolha.orgao || 'ver notícia'}. Fase: ${escolha.fase || 'n/d'}. Resumo: ${noticia.resumo}`,\n  linkNoticia: noticia.link,\n  rowIndex: null,\n  sheetsUrl: null,\n  cfg: {\n    wpUrl: cfg.WORDPRESS_URL,\n    urlCurso: cfg.URL_CURSO_PADRAO,\n    whatsapp: cfg.WHATSAPP,\n    siteName: cfg.SITE_NAME,\n    screenshotUrl: cfg.SCREENSHOT_URL,\n    CAT_NOTICIAS: cfg.CAT_NOTICIAS,\n    CAT_MATERIA: cfg.CAT_MATERIA,\n    TAGS_UF: cfg.TAGS_UF,\n    CAPA_MODELO_NOTICIA: cfg.CAPA_MODELO_NOTICIA,\n    CAPA_MODELO_TEMA: cfg.CAPA_MODELO_TEMA,\n    LOGO_URL: cfg.LOGO_URL,\n    WP_STATUS: cfg.WP_STATUS\n  },\n  systemPromptB64: cfg.SYSTEM_PROMPT_B64\n}}];\n"
      },
